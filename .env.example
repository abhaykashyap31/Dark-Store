# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/auth_db
DB_USERNAME=postgres
DB_PASSWORD=your-local-postgres-password

# Service-to-service and authentication secrets
JWT_SECRET=replace-with-generated-secret-at-least-32-characters
INVENTORY_INTERNAL_TOKEN=replace-with-generated-inventory-token
ADMIN_PASSWORD=Admin@123

# Local service URLs
AUTH_SERVICE_URL=http://localhost:8081
INVENTORY_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083
