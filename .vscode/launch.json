{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "iDarkStore (mocks · Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-hostname=localhost",
        "--web-port=5000"
      ],
      "toolArgs": [
        "--web-hostname=localhost",
        "--web-port=5000"
      ]
    },
    {
      "name": "iDarkStore (live Gateway · Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-hostname=localhost",
        "--web-port=5000"
      ],
      "toolArgs": [
        "--web-hostname=localhost",
        "--web-port=5000",
        "--dart-define=USE_MOCK_APIS=false",
        "--dart-define=API_BASE_URL=http://localhost:8080/api/v1",
        "--dart-define=ENABLE_API_LOGS=true"
      ]
    }
  ]
}
